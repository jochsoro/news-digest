import Foundation
import UIKit
import Capacitor

/**
 * Barre d'onglets NATIVE flottante, posée au-dessus de la webview.
 *
 * Le fond est un `UIVisualEffectView` dont l'effet est **UIGlassEffect** quand
 * le système le fournit (iOS 26+) : c'est le vrai matériau Liquid Glass, avec
 * sa réfraction et ses reflets, impossible à reproduire en CSS dans un
 * WKWebView. La classe est résolue à l'exécution (`NSClassFromString`), ce qui
 * permet de compiler avec un SDK antérieur ; on retombe alors sur le matériau
 * translucide standard, qui reste natif.
 *
 * On n'utilise pas `UITabBarController` : la navigation appartient à Angular.
 * La barre remonte la sélection au JS, et le JS lui dit quoi marquer actif.
 */

struct LiquidTab {
    let key: String
    let title: String
    let symbol: String
}

/// Teinte du contenu situé DERRIÈRE la barre, pour choisir la couleur du texte.
enum LiquidTone: String {
    case auto
    case light
    case dark
}

final class LiquidTabBarHost: NSObject {

    private let container = UIView()
    private let effectView: UIVisualEffectView
    private let stack = UIStackView()
    private var buttons: [UIButton] = []
    private var tabs: [LiquidTab] = []
    private var selectedIndex: Int = 0
    private var tone: LiquidTone = .auto

    private weak var parent: UIViewController?

    /// Hauteur de la capsule, hors marge basse et zone sûre.
    private let barHeight: CGFloat = 56
    /// Écart entre la capsule et le bas de la zone sûre.
    private let bottomGap: CGFloat = 12

    var onSelect: ((String) -> Void)?

    init(parent: UIViewController) {
        self.parent = parent
        self.effectView = UIVisualEffectView(effect: LiquidTabBarHost.material())
        super.init()

        // Le conteneur porte l'ombre : l'effet, lui, est rogné par son arrondi.
        container.translatesAutoresizingMaskIntoConstraints = false
        container.isHidden = true
        container.layer.shadowColor = UIColor.black.cgColor
        container.layer.shadowOpacity = 0.22
        container.layer.shadowRadius = 18
        container.layer.shadowOffset = CGSize(width: 0, height: 8)

        effectView.translatesAutoresizingMaskIntoConstraints = false
        effectView.clipsToBounds = true
        effectView.layer.cornerRadius = barHeight / 2
        effectView.layer.cornerCurve = .continuous
        effectView.layer.borderWidth = 0.5
        effectView.layer.borderColor = UIColor.white.withAlphaComponent(0.35).cgColor

        stack.translatesAutoresizingMaskIntoConstraints = false
        stack.axis = .horizontal
        stack.alignment = .fill
        stack.distribution = .fill
        stack.spacing = 4

        container.addSubview(effectView)
        effectView.contentView.addSubview(stack)
        parent.view.addSubview(container)

        NSLayoutConstraint.activate([
            container.centerXAnchor.constraint(equalTo: parent.view.centerXAnchor),
            container.bottomAnchor.constraint(
                equalTo: parent.view.safeAreaLayoutGuide.bottomAnchor,
                constant: -bottomGap
            ),
            container.heightAnchor.constraint(equalToConstant: barHeight),

            effectView.topAnchor.constraint(equalTo: container.topAnchor),
            effectView.bottomAnchor.constraint(equalTo: container.bottomAnchor),
            effectView.leadingAnchor.constraint(equalTo: container.leadingAnchor),
            effectView.trailingAnchor.constraint(equalTo: container.trailingAnchor),

            stack.topAnchor.constraint(equalTo: effectView.contentView.topAnchor, constant: 5),
            stack.bottomAnchor.constraint(equalTo: effectView.contentView.bottomAnchor, constant: -5),
            stack.leadingAnchor.constraint(equalTo: effectView.contentView.leadingAnchor, constant: 5),
            stack.trailingAnchor.constraint(equalTo: effectView.contentView.trailingAnchor, constant: -5)
        ])
    }

    /// Liquid Glass si le système le propose, matériau translucide sinon.
    private static func material() -> UIVisualEffect {
        if let glassClass = NSClassFromString("UIGlassEffect") as? NSObject.Type,
           let glass = glassClass.init() as? UIVisualEffect {
            return glass
        }
        return UIBlurEffect(style: .systemThinMaterial)
    }

    static var glassAvailable: Bool {
        NSClassFromString("UIGlassEffect") != nil
    }

    // MARK: - Mesures

    var height: CGFloat { barHeight + bottomGap + safeBottom }

    var safeBottom: CGFloat { parent?.view.safeAreaInsets.bottom ?? 0 }

    var isRegularWidth: Bool { parent?.traitCollection.horizontalSizeClass == .regular }

    // MARK: - Contenu

    func apply(tabs: [LiquidTab], active: String?, tone: LiquidTone) {
        self.tone = tone
        self.tabs = tabs

        buttons.forEach { stack.removeArrangedSubview($0); $0.removeFromSuperview() }

        buttons = tabs.enumerated().map { index, tab in
            let action = UIAction(title: tab.title) { [weak self] _ in
                guard let self, index < self.tabs.count else { return }
                self.selectIndex(index, animated: true)
                self.onSelect?(self.tabs[index].key)
            }
            let button = UIButton(configuration: Self.configuration(for: tab), primaryAction: action)
            button.accessibilityLabel = tab.title
            button.tag = index
            stack.addArrangedSubview(button)
            return button
        }

        let index = tabs.firstIndex { $0.key == active } ?? 0
        selectIndex(index, animated: false)
        parent?.view.bringSubviewToFront(container)
    }

    /// Configuration figée d'un onglet (image + libellé) ; l'état est appliqué ensuite.
    private static func configuration(for tab: LiquidTab) -> UIButton.Configuration {
        var config = UIButton.Configuration.plain()
        config.image = UIImage(
            systemName: tab.symbol,
            withConfiguration: UIImage.SymbolConfiguration(pointSize: 17, weight: .semibold)
        )
        config.imagePadding = 7
        config.contentInsets = NSDirectionalEdgeInsets(top: 0, leading: 16, bottom: 0, trailing: 18)
        config.background.cornerRadius = 23

        var title = AttributedString(tab.title)
        title.font = UIFont.systemFont(ofSize: 15, weight: .semibold)
        config.attributedTitle = title

        return config
    }

    /// Couleur du texte : dictée par le contenu situé derrière la barre.
    private var inkColor: UIColor {
        switch tone {
        case .dark: return .white
        case .light: return .black
        case .auto: return .label
        }
    }

    private var inverseInkColor: UIColor {
        switch tone {
        case .dark: return .black
        case .light: return .white
        case .auto: return .systemBackground
        }
    }

    private func selectIndex(_ index: Int, animated: Bool) {
        guard index >= 0, index < buttons.count else { return }
        selectedIndex = index
        let paint = { self.paintStates() }
        if animated {
            UIView.animate(withDuration: 0.25, delay: 0, options: [.curveEaseOut], animations: paint)
        } else {
            paint()
        }
    }

    private func paintStates() {
        for (index, button) in buttons.enumerated() {
            var config = button.configuration
            let isSelected = index == selectedIndex
            config?.background.backgroundColor = isSelected ? inkColor : .clear
            config?.baseForegroundColor = isSelected
                ? inverseInkColor
                : inkColor.withAlphaComponent(0.72)
            button.configuration = config
        }
    }

    func select(key: String, animated: Bool) {
        guard let index = tabs.firstIndex(where: { $0.key == key }) else { return }
        selectIndex(index, animated: animated)
    }

    func setTone(_ tone: LiquidTone) {
        guard tone != self.tone else { return }
        self.tone = tone
        effectView.layer.borderColor = UIColor.white
            .withAlphaComponent(tone == .dark ? 0.3 : 0.35).cgColor
        UIView.animate(withDuration: 0.25) { self.paintStates() }
    }

    func setVisible(_ visible: Bool) {
        container.isHidden = !visible
        if visible { parent?.view.bringSubviewToFront(container) }
    }
}

@objc(LiquidTabBarPlugin)
public class LiquidTabBarPlugin: CAPPlugin, CAPBridgedPlugin {
    public let identifier = "LiquidTabBarPlugin"
    public let jsName = "LiquidTabBar"
    public let pluginMethods: [CAPPluginMethod] = [
        CAPPluginMethod(name: "configure", returnType: CAPPluginReturnPromise),
        CAPPluginMethod(name: "setActive", returnType: CAPPluginReturnPromise),
        CAPPluginMethod(name: "setTone", returnType: CAPPluginReturnPromise),
        CAPPluginMethod(name: "setVisible", returnType: CAPPluginReturnPromise),
        CAPPluginMethod(name: "metrics", returnType: CAPPluginReturnPromise)
    ]

    private var host: LiquidTabBarHost?

    @objc func configure(_ call: CAPPluginCall) {
        guard let raw = call.getArray("items", JSObject.self), !raw.isEmpty else {
            call.reject("items manquant ou vide")
            return
        }

        let tabs: [LiquidTab] = raw.compactMap { entry in
            guard
                let key = entry["key"] as? String,
                let title = entry["title"] as? String
            else { return nil }
            return LiquidTab(key: key, title: title, symbol: entry["symbol"] as? String ?? "circle")
        }

        guard !tabs.isEmpty else {
            call.reject("aucun onglet exploitable")
            return
        }

        let active = call.getString("active")
        let visible = call.getBool("visible", true)
        let tone = LiquidTone(rawValue: call.getString("tone") ?? "auto") ?? .auto

        DispatchQueue.main.async { [weak self] in
            guard let self else { return }
            guard let viewController = self.bridge?.viewController else {
                call.reject("view controller indisponible")
                return
            }

            if self.host == nil {
                let host = LiquidTabBarHost(parent: viewController)
                host.onSelect = { [weak self] key in
                    self?.notifyListeners("select", data: ["key": key])
                }
                self.host = host
            }

            self.host?.apply(tabs: tabs, active: active, tone: tone)
            self.host?.setVisible(visible)
            call.resolve(self.snapshot())
        }
    }

    @objc func setActive(_ call: CAPPluginCall) {
        guard let key = call.getString("key") else {
            call.reject("key manquant")
            return
        }
        DispatchQueue.main.async { [weak self] in
            self?.host?.select(key: key, animated: true)
            call.resolve()
        }
    }

    @objc func setTone(_ call: CAPPluginCall) {
        let tone = LiquidTone(rawValue: call.getString("tone") ?? "auto") ?? .auto
        DispatchQueue.main.async { [weak self] in
            self?.host?.setTone(tone)
            call.resolve()
        }
    }

    @objc func setVisible(_ call: CAPPluginCall) {
        let visible = call.getBool("visible", true)
        DispatchQueue.main.async { [weak self] in
            self?.host?.setVisible(visible)
            call.resolve(self?.snapshot() ?? [:])
        }
    }

    @objc func metrics(_ call: CAPPluginCall) {
        DispatchQueue.main.async { [weak self] in
            call.resolve(self?.snapshot() ?? [:])
        }
    }

    private func snapshot() -> [String: Any] {
        guard let host else {
            return [
                "height": 0,
                "safeBottom": 0,
                "regularWidth": false,
                "glass": LiquidTabBarHost.glassAvailable
            ]
        }
        return [
            "height": host.height,
            "safeBottom": host.safeBottom,
            "regularWidth": host.isRegularWidth,
            // Le JS peut ainsi dire en clair si le vrai Liquid Glass est actif.
            "glass": LiquidTabBarHost.glassAvailable
        ]
    }
}
